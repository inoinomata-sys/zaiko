{% extends 'base.twig' %}
{% block title %}スタッフ{% endblock %}
{% block head %}
<style>
.st-card { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }
.st-card.off { opacity: .55; }
.st-name { flex: 1; font-size: 16px; font-weight: 600; }
.st-home { font-size: 12px; color: #fff; background: var(--acc); border-radius: 6px; padding: 2px 8px; }
.st-wrap { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }
.st-wrap.off { opacity: .55; }
.st-wrap .st-card { border: 0; padding: 0; margin: 0 0 8px; background: transparent; }
.st-days { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.st-days label { display: inline-flex; flex-direction: column; align-items: center; font-size: 12px; gap: 2px; min-width: 34px; }
.st-days input { width: 20px; height: 20px; }
.st-days .lbl { font-size: 12px; color: var(--fg2); margin-right: 4px; }
.st-add { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
.st-add input, .st-add select { font-size: 16px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; font-family: inherit; }
.st-add input { flex: 1; min-width: 140px; }
</style>
{% endblock %}
{% block content %}
<p style="margin-bottom:10px"><a href="/shift">← 出勤スケジュールにもどる</a></p>
<h1 style="font-size:20px;font-weight:700;margin-bottom:6px">スタッフ</h1>
<p style="font-size:13px;color:var(--fg2);margin-bottom:12px">「本店」は、ふだん入る店です。別の店に入る日は、出勤スケジュールに「ヘルプ」の印が出ます。「毎週の休み」にチェックした曜日は、出勤を入れなくても、自動で「休」になります（その日だけ出勤にしたい時は、出勤を入れる画面で、店を選びます）。辞めた人は「外す」にすると、表から消えます（過去の出勤は残ります）。</p>
<form class="st-add" method="post" action="/shift/staff/add">
  <input name="name" placeholder="名前" required maxlength="40">
  <select name="home_store"><option>イノ</option><option>リッチ</option></select>
  <button class="btn" type="submit">足す</button>
</form>
{% for s in staff %}
<div class="st-wrap{% if not s.is_active %} off{% endif %}">
  <div class="st-card">
    <span class="st-name">{{ s.name }}</span>
    <span class="st-home">{{ s.home_store }}</span>
    <form method="post" action="/shift/staff/{{ s.id }}/toggle"><button class="btn btn-ghost btn-sm" type="submit">{{ s.is_active ? '外す' : '戻す' }}</button></form>
  </div>
  <form class="st-days" method="post" action="/shift/staff/{{ s.id }}/off">
    <span class="lbl">毎週の休み</span>
    {% for w in week %}<label>{{ w }}<input type="checkbox" name="off[]" value="{{ loop.index0 }}"{% if loop.index0 in s.offs %} checked{% endif %}></label>{% endfor %}
    <button class="btn btn-ghost btn-sm" type="submit" style="margin-left:auto">保存</button>
  </form>
</div>
{% endfor %}
{% endblock %}
