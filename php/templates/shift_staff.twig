{% extends 'base.twig' %}
{% block title %}スタッフ登録・設定{% endblock %}
{% block head %}
<style>
.st-card { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }
.st-card.off { opacity: .55; }
.st-name { flex: 1; font-size: 16px; font-weight: 600; }
.st-home { font-size: 12px; color: #fff; background: var(--acc); border-radius: 6px; padding: 2px 8px; }
.st-wrap { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }
.st-wrap.off { opacity: .55; }
.st-wrap .st-card { border: 0; padding: 0; margin: 0 0 8px; background: transparent; }
.st-days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px 2px; align-items: center; }
.st-days label { display: flex; flex-direction: column; align-items: center; font-size: 13px; gap: 3px; }
.st-days input[type=checkbox] { width: 22px; height: 22px; margin: 0; }
.st-days .lbl { grid-column: 1 / -1; font-size: 12px; color: var(--fg2); }
.st-days .btn { grid-column: 1 / -1; justify-self: end; margin-top: 4px; }
.st-add { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
.st-add input, .st-add select { font-size: 16px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; font-family: inherit; }
.st-add input[name=name] { flex: 1; min-width: 140px; }
.st-tm { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); align-items: start; gap: 12px; width: 100%; font-size: 13px; color: var(--fg2); }
.st-tm label { display: flex; flex-direction: column; align-items: stretch; gap: 6px; min-width: 0; }
.st-tm input[type=time] { display: block; width: 100%; min-width: 0; height: 48px; box-sizing: border-box; background: #fff; color: var(--fg); font-size: 18px; padding: 10px 8px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; }
</style>
{% endblock %}
{% block content %}
<p style="margin-bottom:10px"><a href="/settings">← 設定にもどる</a></p>
<h1 style="font-size:20px;font-weight:700;margin-bottom:6px">スタッフ登録・設定</h1>
<p style="font-size:13px;color:var(--fg2);margin-bottom:12px">「本店」は、ふだん入る店です。別の店に入る日は、出勤スケジュールに「ヘルプ」の印が出ます。「勤務日」にチェックのない曜日は、出勤を入れなくても、自動で「休」になります（その日だけ出勤にしたい時は、出勤を入れる画面で、店を選びます）。辞めた人は「外す」にすると、表から消えます（過去の出勤は残ります）。</p>
<form class="st-add" method="post" action="/settings/staff/add">
  <input name="name" placeholder="スタッフの名前" aria-label="スタッフの名前" required maxlength="40">
  <select name="home_store" aria-label="所属店舗"><option>イノ</option><option>リッチ</option></select>
  <div class="st-tm"><label>勤務開始<input type="time" name="work_from"></label><label>勤務終了<input type="time" name="work_to"></label></div>
  <button class="btn" type="submit">スタッフを登録</button>
</form>
{% for s in staff %}
<div class="st-wrap{% if not s.is_active %} off{% endif %}">
  <div class="st-card">
    <span class="st-name">{{ s.name }}</span>
    <span class="st-home">{{ s.home_store }}</span>
    <form method="post" action="/settings/staff/{{ s.id }}/toggle"><button class="btn btn-ghost btn-sm" type="submit">{{ s.is_active ? '外す' : '戻す' }}</button></form>
  </div>
  <form class="st-days" method="post" action="/settings/staff/{{ s.id }}/off">
    <span class="lbl">勤務日（チェック＝出勤）</span>
    {% for w in week %}<label>{{ w }}<input type="checkbox" name="work[]" value="{{ loop.index0 }}"{% if loop.index0 not in s.offs %} checked{% endif %}></label>{% endfor %}
    <span class="lbl">勤務時間</span>
    <div class="st-tm" style="grid-column:1/-1"><label>開始<input type="time" name="work_from" value="{{ s.work_from }}"></label><label>終了<input type="time" name="work_to" value="{{ s.work_to }}"></label></div>
    <button class="btn btn-ghost btn-sm" type="submit">保存</button>
  </form>
</div>
{% endfor %}
{% endblock %}
