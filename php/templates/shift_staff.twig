{% extends 'base.twig' %}
{% block title %}スタッフ登録・設定{% endblock %}
{% block head %}
<style>
.st-card { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }
.st-card.off { opacity: .55; }
.st-name { flex: 1; min-width: 0; overflow-wrap: anywhere; font-size: 16px; font-weight: 600; }
.st-home { font-size: 12px; color: #fff; background: var(--acc); border-radius: 6px; padding: 2px 8px; }
.st-wrap { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }
.st-wrap.off { opacity: .55; }
.st-wrap .st-card { border: 0; padding: 0; margin: 0 0 8px; background: transparent; }
.st-days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px 2px; align-items: center; }
.st-days label { display: flex; flex-direction: column; align-items: center; font-size: 13px; gap: 3px; }
.st-days input[type=checkbox] { width: 22px; height: 22px; margin: 0; }
.st-days .lbl { grid-column: 1 / -1; font-size: 12px; color: var(--fg2); }
.st-days .btn { grid-column: 1 / -1; justify-self: end; margin-top: 4px; }
.st-add { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
.st-add input, .st-add select { font-size: 16px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; font-family: inherit; }
.st-add input[name=name] { flex: 1; min-width: 140px; }
.st-tm { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); align-items: start; gap: 12px; width: 100%; min-width: 0; max-width: 100%; font-size: 13px; color: var(--fg2); }
.st-tm label { display: flex; flex-direction: column; align-items: stretch; gap: 6px; width: 100%; min-width: 0; max-width: 100%; overflow: hidden; }
.st-tm input[type=time] { display: block; -webkit-appearance: none; appearance: none; width: 100%; min-width: 0; max-width: 100%; height: 48px; flex: 0 0 48px; box-sizing: border-box; background: #fff; color: var(--fg); font-size: 18px; padding: 10px 8px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; }
/* iOSの時刻欄の内部幅が、2列の幅を押し広げないようにする。 */
.st-tm input[type=time]::-webkit-date-and-time-value { min-width: 0; margin: 0; text-align: left; }
.st-tm input[type=time]::-webkit-datetime-edit { min-width: 0; padding: 0; }
@media(max-width:360px) { .st-tm { gap: 8px; } .st-tm input[type=time] { font-size: 16px; padding: 10px 4px; } }
.st-add-days {width:100%;min-width:0;border:0;padding:8px 0;margin:0}
.st-add-days legend {font-size:13px;color:var(--fg2);margin-bottom:8px}
.st-add .st-add-days input[type=checkbox] {width:24px;height:24px;padding:0;margin:0;accent-color:var(--acc)}
.st-role{display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--fg2);width:100%;margin-bottom:8px}.st-role select{width:100%;font-size:16px;padding:10px;border:1px solid var(--border);border-radius:10px;background:#fff;color:var(--fg)}
.st-holiday,.st-days .st-holiday{display:flex;flex-direction:row;align-items:center;gap:10px;min-height:46px;width:100%;padding:10px 0;font-size:14px;color:var(--fg)}.st-holiday input[type=checkbox]{width:24px;height:24px;padding:0;margin:0;accent-color:var(--acc)}
.st-role-choice{border:0;min-width:0;width:100%;padding:12px 0;margin:0 0 12px}.st-role-choice legend{font-size:14px;font-weight:600;color:var(--fg);margin-bottom:8px}.st-role-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.st-role-options label,.st-days .st-role-options label{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;min-height:76px;padding:12px 3px;border:1px solid var(--border);border-radius:12px;background:#fff;font-size:14px;color:var(--fg);cursor:pointer}
.st-role-options label:has(input:checked){background:#faf5e8;border-color:var(--gold)}
.st-role-options input[type=radio],.st-add .st-role-options input[type=radio]{width:22px;height:22px;min-width:22px;padding:0;margin:0;accent-color:var(--acc)}
.st-role-warning{font-size:12px;color:#705a27;margin-top:10px;line-height:1.7}
.st-days .st-save{justify-self:stretch;justify-content:center;min-height:48px;margin-top:16px;font-size:15px}
</style>
{% endblock %}
{% block content %}
<p style="margin-bottom:10px"><a href="/settings">← 設定にもどる</a></p>
<h1 style="font-size:20px;font-weight:700;margin-bottom:6px">スタッフ登録・設定</h1>
<p style="font-size:13px;color:var(--fg2);margin-bottom:12px">「本店」は、ふだん入る店です。別の店に入る日は、出勤スケジュールに「ヘルプ」の印が出ます。「勤務日」にチェックのない曜日は、出勤を入れなくても、自動で「休」になります（その日だけ出勤にしたい時は、出勤を入れる画面で、店を選びます）。「退社・登録解除」で通常の一覧から外せます。過去の出勤は残り、「登録解除したスタッフ」から戻せます。</p>
<p style="font-size:13px;color:var(--fg2);margin:10px 0">お客様用の休み表には「スタイリスト」に設定したイノ店のスタッフだけを掲載します。</p>
<form class="st-add" method="post" action="/settings/staff/add">
  <input name="name" placeholder="スタッフの名前" aria-label="スタッフの名前" required maxlength="40">
  <select name="home_store" aria-label="所属店舗"><option>イノ</option><option>リッチ</option></select>
  <fieldset class="st-role-choice"><legend>職種</legend><div class="st-role-options"><label><input type="radio" name="role" value="stylist" required>スタイリスト</label><label><input type="radio" name="role" value="assistant" required>アシスタント</label></div></fieldset>
  <div class="st-tm"><label>勤務開始<input type="time" name="work_from"></label><label>勤務終了<input type="time" name="work_to"></label></div>
  <input type="hidden" name="work_days_present" value="1">
  <fieldset class="st-add-days"><legend>勤務日（チェック＝出勤）</legend><div class="st-days">
  {% for w in week %}<label>{{ w }}<input type="checkbox" name="work[]" value="{{ loop.index0 }}"{% if loop.index0 >= 2 %} checked{% endif %}></label>{% endfor %}
  </div></fieldset>
  <input type="hidden" name="holiday_setting_present" value="1"><label class="st-holiday"><input type="checkbox" name="holiday_off" value="1">祝日は休み</label>
  <button class="btn" type="submit">スタッフを登録</button>
</form>
{% for s in staff %}{% if s.is_active %}
<div class="st-wrap">
  <div class="st-card">
    <span class="st-name">{{ s.name }}</span>
    <span class="st-home">{{ s.home_store }}</span>
    <form class="st-remove" method="post" action="/settings/staff/{{ s.id }}/toggle" data-name="{{ s.name }}"><input type="hidden" name="is_active" value="0"><button class="btn btn-ghost btn-sm" type="submit">退社・登録解除</button></form>
  </div>
  <form class="st-days" method="post" action="/settings/staff/{{ s.id }}/off">
    <fieldset class="st-role-choice" style="grid-column:1/-1"><legend>職種を選んでください</legend><div class="st-role-options"><label><input type="radio" name="role" value="stylist"{% if s.role == 'stylist' %} checked{% endif %}>スタイリスト</label><label><input type="radio" name="role" value="assistant"{% if s.role == 'assistant' %} checked{% endif %}>アシスタント</label></div>{% if not s.role %}<p class="st-role-warning">職種が未設定です。選んで下の「設定を保存する」を押してください。</p>{% endif %}</fieldset>
    <span class="lbl">勤務日（チェック＝出勤）</span>
    {% for w in week %}<label>{{ w }}<input type="checkbox" name="work[]" value="{{ loop.index0 }}"{% if loop.index0 not in s.offs %} checked{% endif %}></label>{% endfor %}
    <input type="hidden" name="holiday_setting_present" value="1"><label class="st-holiday" style="grid-column:1/-1"><input type="checkbox" name="holiday_off" value="1"{% if s.holiday_off %} checked{% endif %}>祝日は休み</label>
    <span class="lbl">勤務時間</span>
    <div class="st-tm" style="grid-column:1/-1"><label>開始<input type="time" name="work_from" value="{{ s.work_from|time_input }}"></label><label>終了<input type="time" name="work_to" value="{{ s.work_to|time_input }}"></label></div>
    <button class="btn btn-primary st-save" type="submit">設定を保存する</button>
  </form>
</div>
{% endif %}{% endfor %}
<details class="st-archive" style="margin-top:20px;border-top:1px solid var(--border);padding-top:16px">
<summary style="cursor:pointer;color:var(--fg2);padding:8px 0">登録解除したスタッフ</summary>
{% for s in staff %}{% if not s.is_active %}
<div class="st-card"><span class="st-name">{{ s.name }}</span><span class="st-home">{{ s.home_store }}</span><form method="post" action="/settings/staff/{{ s.id }}/toggle"><input type="hidden" name="is_active" value="1"><button class="btn btn-ghost btn-sm" type="submit">一覧に戻す</button></form></div>
{% endif %}{% endfor %}
</details>
{% endblock %}
{% block scripts %}<script>
document.querySelectorAll('.st-remove').forEach(form => form.addEventListener('submit', event => {
 if (!confirm(form.dataset.name + 'さんを通常の一覧から外しますか？ 過去の出勤記録は残り、あとで戻せます。')) event.preventDefault();
}));
</script>{% endblock %}
