{% extends 'base.twig' %}
{% block title %}出勤スケジュール{% endblock %}
{% block head %}
<style>
.sh-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
.sh-top h1 { font-size: 20px; font-weight: 700; }
.sh-nav { display: flex; align-items: center; gap: 6px; }
.sh-nav a { padding: 7px 12px; border: 1px solid var(--border); border-radius: 10px; background: #fff; color: var(--fg); text-decoration: none; }
.sh-me { width: 100%; font-size: 16px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; margin-bottom: 10px; background: #fff; font-family: inherit; }
@page { size: A4 landscape; margin: 8mm; }
@media print {
  nav, #pwa-banner, #to-top, #toast, .no-print, .sh-bar, .ent-list, #detail, .sh-foot, .back-link, .sh-nav a { display: none !important; }
  body, main { background: #fff !important; padding: 0 !important; margin: 0 !important; max-width: none !important; }
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .cal { max-width: none; }
  .cal-cell { min-height: 27mm; font-size: 10pt; border-color: #999; break-inside: avoid; box-shadow: none !important; background: #fff !important; }
  .cal-d { font-size: 12pt; }
  .cal-hol { font-size: 8pt; }
  .cal-ev { font-size: 9pt; }
  .cal-head div { font-size: 10pt; }
  h1 { font-size: 16pt !important; }
  /* 白黒印刷：色に頼らず、文字と線で見分ける */
  html, body, main, * { color: #000 !important; }
  .cal-cell { border: 1px solid #000 !important; border-radius: 0 !important; }
  .cal-cell.blank { border-color: transparent !important; }
  .cal-cell.today { border-width: 2px !important; }
  .cal-d.sun { background: #ddd !important; }
  .cal-d.sun .cal-hol, .cal-hol { font-weight: 700; }
  .cal-bar { font-size: 9pt; background: #fff !important; border: 1px solid #000 !important; border-radius: 0 !important; overflow: visible; white-space: normal; opacity: 1 !important; outline: none !important; }
  .cal-bar.rest { border-style: dashed !important; border-width: 2px !important; font-weight: 700; }
  .cal-legend i { display: none !important; }
  .cal-nt { display: none !important; }
  .cal-ev { border-left: 3px solid #000 !important; }

  .sh-top { margin-bottom: 4mm; }
}
.sh-bar { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin: -4px 0 10px; }
.sh-stamp { font-size: 13px; color: var(--fg2); }
.ent-btn { font-size: 13px; padding: 5px 12px; border: 1px solid var(--border); border-radius: 999px; background: transparent; color: var(--fg2); font-family: inherit; cursor: pointer; }
.sh-stamp a { margin-left: 4px; }
.ent-list[hidden] { display: none; }
.ent-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; margin: -2px 0 12px; }
.ent-name { text-align: center; padding: 12px 6px; background: #fff; border: 1px solid var(--acc); border-radius: 10px; color: var(--acc); font-weight: 700; font-size: 16px; text-decoration: none; }
.cal { max-width: 1000px; margin: 0 auto; }
.cal-head, .cal-week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 2px; }
.cal-head div { text-align: center; font-size: 12px; font-weight: 700; padding: 4px 0; color: var(--fg2); }
.cal-head .sun { color: #c0392b; } .cal-head .sat { color: #2c6fb7; }
.cal-week { margin-bottom: 2px; }
.cal-week { position: relative; align-content: start; }
.cal-cell { min-width: 0; min-height: 64px; background: #fff; border: 1px solid var(--border); border-radius: 6px; cursor: pointer; overflow: hidden; z-index: 0; }
.cal-d { z-index: 1; padding: 2px 4px; cursor: pointer; align-self: start; }
.cal-bar { z-index: 2; align-self: start; margin: 1px 3px; padding: 1px 5px; font-size: 11px; line-height: 1.35; border-radius: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff; background: var(--c); border: 1px solid var(--c); cursor: pointer; min-width: 0; }
.cal-bar.work { background: #fff; color: var(--c); }
.cal-bar.dflt { opacity: .4; }
.cal-bar.me { outline: 2px solid #e0a020; outline-offset: 1px; }
.cal-cell.blank { background: transparent; border-color: transparent; cursor: default; }
.cal-cell.today { border-color: var(--acc); box-shadow: 0 0 0 1px var(--acc); }
.cal-cell.sel { background: #fffbe8; box-shadow: 0 0 0 2px #e0a020; }
.cal-d { font-size: 13px; font-weight: 700; display: flex; align-items: baseline; gap: 3px; min-width: 0; }
.cal-d.sun { color: #c0392b; } .cal-d.sat { color: #2c6fb7; }
.cal-hol { font-size: 9px; font-weight: 400; color: #c0392b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.cal-nt { font-size: 9px; font-weight: 400; color: #8a6d00; margin-left: auto; white-space: nowrap; }
.nt-box { margin-top: 8px; border-top: 1px dashed var(--border); padding-top: 8px; }
.nt { display: flex; gap: 8px; align-items: baseline; padding: 3px 0; font-size: 14px; }
.nt-by { flex: 0 0 auto; font-size: 12px; font-weight: 700; color: #fff; background: #8a6d00; border-radius: 6px; padding: 0 6px; }
.nt-body { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.nt-del { border: 0; background: transparent; color: var(--fg2); font-size: 16px; cursor: pointer; padding: 0 4px; }
.nt-form { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
.nt-form select, .nt-form input { font-size: 16px; padding: 7px 8px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; }
.nt-form input { flex: 1; min-width: 140px; }
.cal-legend { display: flex; gap: 12px; flex-wrap: wrap; font-size: 12px; color: var(--fg2); margin: 8px 2px; }
.cal-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; vertical-align: -1px; margin-right: 3px; background: var(--acc); }
.cal-legend i.rich { background: #3b7dd8; } .cal-legend i.off { background: #b5b5b5; }
.sh-detail { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; margin: 10px 0; }
.sh-date { font-weight: 700; margin-bottom: 6px; }
.sh-date .sun { color: #c0392b; } .sh-date .sat { color: #2c6fb7; }
.sh-date small { font-weight: 400; color: #c0392b; margin-left: 6px; }
.sh-row { display: flex; gap: 8px; padding: 3px 0; align-items: baseline; }
.sh-store { flex: 0 0 52px; font-size: 12px; font-weight: 700; color: #fff; background: var(--acc); border-radius: 6px; text-align: center; padding: 2px 0; }
.sh-store.rich { background: #3b7dd8; }
.sh-store.off { background: #9a9a9a; }
.sh-people { flex: 1; display: flex; flex-wrap: wrap; gap: 4px 8px; }
.sh-p { font-size: 15px; }
.sh-p.me { background: #fff3a8; border-radius: 6px; padding: 0 5px; font-weight: 700; }
.sh-tag { font-size: 11px; border-radius: 5px; padding: 0 5px; margin-left: 3px; vertical-align: 1px; }
.sh-tag.help { background: #e8f0fe; color: #1a56b0; border: 1px solid #b9cdf5; }
.sh-tag.chg { background: #fde8e8; color: #b3261e; border: 1px solid #f2b8b5; }
.sh-none { color: var(--fg2); font-size: 14px; }
.sh-foot { display: flex; gap: 10px; margin: 14px 0 30px; }
.sh-foot a { flex: 1; text-align: center; padding: 12px; border: 1px solid var(--acc); border-radius: 10px; color: var(--acc); text-decoration: none; font-weight: 600; background: #fff; }
@media (max-width: 560px) { .cal-cell { min-height: 70px; } .cal-bar { font-size: 9px; margin: 1px 1px; padding: 0 2px; } .cal-d { font-size: 12px; padding: 1px 2px; } .cal-hol { font-size: 8px; } }
</style>
{% endblock %}
{% block content %}
<p class="no-print" style="font-size:13px;color:var(--fg2)">出勤予定はこのカレンダーで確認できます。LINEには送信しません。</p>
<p class="back-link" style="margin-bottom:8px"><a href="/">← トップにもどる</a></p>
<div class="sh-top">
  <h1>出勤スケジュール</h1>
  <div class="sh-nav">
    <a href="/shift?month={{ nav.prev }}">‹</a>
    <b>{{ nav.label }}</b>
    <a href="/shift?month={{ nav.next }}">›</a>
  </div>
</div>
<div class="sh-bar">
  <div class="sh-stamp">{% if last_at %}最終入力 <b>{{ last_at }}</b>{% else %}まだ入力はありません{% endif %}</div>
  <span style="display:flex;gap:6px">{% if staff %}<button type="button" id="ent-btn" class="ent-btn">休み希望を入れる ▾</button>{% endif %}</span>
</div>
{% if staff %}
<div id="ent-list" class="ent-list" hidden>
  {% for s in staff %}<a class="ent-name" data-sid="{{ s.id }}" href="/shift/edit?month={{ nav.month }}&staff={{ s.id }}">{{ s.name }}</a>{% endfor %}
</div>
{% else %}
<p style="color:var(--fg2);margin:14px 0">まだスタッフがいません。下の「スタッフ」から入れてください。</p>
{% endif %}
<div class="cal">
  <div class="cal-head"><div>月</div><div>火</div><div>水</div><div>木</div><div>金</div><div class="sat">土</div><div class="sun">日</div></div>
  {% for w in weeks %}
  <div class="cal-week" style="grid-template-rows: repeat({{ w.lanes + 1 }}, auto) 1fr">
    {% for day in w.days %}
    {% if day %}
    <div class="cal-cell{% if day.today %} today{% endif %}" data-date="{{ day.date }}" style="grid-column:{{ loop.index }};grid-row:1 / -1">
      <div class="cal-detail" hidden>
        <div class="sh-date">{{ nav.label|slice(5) }}{{ day.d }}日 <span class="{% if day.sun %}sun{% elseif day.sat %}sat{% endif %}">（{{ day.w }}）</span>{% if day.hol %}<small>{{ day.hol }}</small>{% endif %}</div>
        {% for store, people in day.groups %}{% if people %}
        <div class="sh-row">
          <span class="sh-store{% if store == 'リッチ' %} rich{% elseif store == '休' %} off{% endif %}">{{ store }}</span>
          <span class="sh-people">
            {% for p in people %}<span class="sh-p" data-sid="{{ p.id }}">{{ p.name }}{% if p.help %}<span class="sh-tag help">{{ p.from }}から</span>{% endif %}{% if p.time_l %}<span class="sh-tag help">{{ p.time_l }}だけ休み</span>{% endif %}{% if p.changed %}<span class="sh-tag chg">変更</span>{% endif %}</span>{% endfor %}
          </span>
        </div>
        {% endif %}{% endfor %}
        {% if not day.any %}<div class="sh-none">出勤はまだ入っていません</div>{% endif %}
        <div class="nt-box">
          {% for n in day.notes %}<div class="nt"><span class="nt-by">{{ n.author ?: '—' }}</span><span class="nt-body">{{ n.body }}</span><button type="button" class="nt-del" data-id="{{ n.id }}" aria-label="メモを消す">×</button></div>{% endfor %}
          <form class="nt-form" data-date="{{ day.date }}">
            <select class="nt-who">{% for st in staff %}<option value="{{ st.name }}" data-sid="{{ st.id }}">{{ st.name }}</option>{% endfor %}</select>
            <input class="nt-text" maxlength="300" placeholder="メモ（例: 12時半から出ます）" required>
            <button type="submit" class="btn btn-sm">書く</button>
          </form>
        </div>
      </div>
    </div>
    <div class="cal-d{% if day.sun %} sun{% elseif day.sat %} sat{% endif %}" data-date="{{ day.date }}" style="grid-column:{{ loop.index }};grid-row:1">{{ day.d }}{% if day.hol %}<span class="cal-hol">{{ day.hol }}</span>{% endif %}{% if day.notes %}<span class="cal-nt">✎{{ day.notes|length }}</span>{% endif %}</div>
    {% else %}<div class="cal-cell blank" style="grid-column:{{ loop.index }};grid-row:1 / -1"></div>{% endif %}
    {% endfor %}
    {% for b in w.bars %}
    <div class="cal-bar {{ b.store == '休' ? 'rest' : 'work' }}{% if b.dflt %} dflt{% endif %}{% if b.help %} help{% endif %}" data-date="{{ b.date }}" data-sid="{{ b.id }}" style="--c:{{ b.color }};grid-column:{{ b.c }} / span {{ b.n }};grid-row:{{ b.r + 2 }}">{% if b.store == '休' %}{{ b.name }}休み{% if b.time %} {{ b.time }}{% endif %}{% else %}{{ b.name }}（{{ b.store }}{% if b.help %}・ヘルプ{% endif %}）{% endif %}</div>
    {% endfor %}
  </div>
  {% endfor %}
  <div class="cal-legend">{% for st in staff %}<span><i style="background:{{ st.color }}"></i>{{ st.name }}</span>{% endfor %}<span>色つき＝休み</span><span>白＝出勤（店名つき）</span><span style="color:#c0392b">赤＝日曜・祝日</span></div>
  <div class="sh-detail" id="detail"><div class="sh-none">日をタップすると、くわしく出ます</div></div>
</div>
<div class="sh-foot">
  <a href="/shift/edit?month={{ nav.month }}">出勤を入れる</a>
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
  const btn = document.getElementById('ent-btn'), list = document.getElementById('ent-list');
  const detail = document.getElementById('detail');
  const cells = [...document.querySelectorAll('.cal-cell[data-date]')];
  const cellOf = d => cells.find(x => x.dataset.date === d);
  let me = '';
  try { me = localStorage.getItem('shift:me') || ''; } catch (e) {}
  function paint() {
    document.querySelectorAll('.cal-bar, .sh-p').forEach(p => p.classList.toggle('me', me !== '' && p.dataset.sid === me));
  }
  function show(c) {
    cells.forEach(x => x.classList.toggle('sel', x === c));
    detail.innerHTML = c.querySelector('.cal-detail').innerHTML;
    paint(); paintWho();
  }
  document.querySelectorAll('.cal-cell[data-date], .cal-d[data-date], .cal-bar[data-date]').forEach(e => e.addEventListener('click', () => { const c = cellOf(e.dataset.date); if (c) show(c); }));
  if (btn) btn.addEventListener('click', () => { list.hidden = !list.hidden; });
  document.querySelectorAll('.ent-name').forEach(a => a.addEventListener('click', () => { try { localStorage.setItem('shift:me', a.dataset.sid); } catch (e) {} }));
  function paintWho() {
    detail.querySelectorAll('.nt-who').forEach(sel => { [...sel.options].forEach(o => { if (me !== '' && o.dataset.sid === me) sel.value = o.value; }); });
  }
  const post = (url, body) => fetch(url, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)}).then(r => r.json());
  detail.addEventListener('submit', async e => {
    const f = e.target.closest('.nt-form'); if (!f) return;
    e.preventDefault();
    const text = f.querySelector('.nt-text').value.trim(); if (!text) return;
    try {
      const j = await post('/api/shift/note', {date: f.dataset.date, author: f.querySelector('.nt-who').value, body: text});
      if (!j.ok) throw 0;
      location.hash = f.dataset.date; location.reload();
    } catch (err) { alert('書き込めませんでした。もう一度お試しください'); }
  });
  detail.addEventListener('click', async e => {
    const b = e.target.closest('.nt-del'); if (!b) return;
    if (!confirm('このメモを消しますか？')) return;
    const f = detail.querySelector('.nt-form');
    try {
      const j = await post('/api/shift/note/delete', {id: +b.dataset.id});
      if (!j.ok) throw 0;
      location.hash = f ? f.dataset.date : ''; location.reload();
    } catch (err) { alert('消せませんでした。もう一度お試しください'); }
  });
  paint();
  const hashDate = (location.hash || '').slice(1);
  const t = cellOf(hashDate) || document.querySelector('.cal-cell.today');
  if (t) show(t);
})();
</script>
{% endblock %}
