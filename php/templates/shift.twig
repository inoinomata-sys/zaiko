{% extends 'base.twig' %}
{% block title %}出勤一覧{% endblock %}
{% block head %}
<style>
.sh-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
.sh-top h1 { font-size: 20px; font-weight: 700; }
.sh-nav { display: flex; align-items: center; gap: 6px; }
.sh-nav a { padding: 7px 12px; border: 1px solid var(--border); border-radius: 10px; background: #fff; color: var(--fg); text-decoration: none; }
.sh-me { width: 100%; font-size: 16px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; margin-bottom: 10px; background: #fff; font-family: inherit; }
@page { size: A4 landscape; margin: 8mm; }
@media print {
  nav, #pwa-banner, #to-top, #toast, .no-print, .sh-bar, .ent-list, #detail, .sh-foot, .back-link, .sh-nav a { display: none !important; }
  body, main { background: #fff !important; padding: 0 !important; margin: 0 !important; max-width: none !important; }
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .cal { max-width: none; }
  .cal-cell { min-height: 27mm; font-size: 10pt; border-color: #999; break-inside: avoid; box-shadow: none !important; background: #fff !important; }
  .cal-d { font-size: 12pt; }
  .cal-hol { font-size: 8pt; }
  .cal-ev { font-size: 9pt; }
  .cal-head div { font-size: 10pt; }
  h1 { font-size: 16pt !important; }
  /* 白黒印刷：色に頼らず、文字と線で見分ける */
  html, body, main, * { color: #000 !important; }
  .cal-cell { border: 1px solid #000 !important; border-radius: 0 !important; }
  .cal-cell.blank { border-color: transparent !important; }
  .cal-cell.today { border-width: 2px !important; }
  .cal-d.sun { background: #ddd !important; }
  .cal-d.sun .cal-hol, .cal-hol { font-weight: 700; }
  .cal-bar { font-size: 9pt; background: #fff !important; border: 1px solid #000 !important; border-radius: 0 !important; overflow: visible; white-space: normal; opacity: 1 !important; outline: none !important; }
  .cal-bar.rest { border-style: dashed !important; border-width: 2px !important; font-weight: 700; }
  .cal-legend i { display: none !important; }
  .cal-nt { display: none !important; }
  .cal-ev { border-left: 3px solid #000 !important; }

  .sh-top { margin-bottom: 4mm; }
}
.sh-bar { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin: -4px 0 10px; }
.sh-stamp { font-size: 13px; color: var(--fg2); }
.ent-btn { font-size: 13px; padding: 5px 12px; border: 1px solid var(--border); border-radius: 999px; background: transparent; color: var(--fg2); font-family: inherit; cursor: pointer; }
.sh-stamp a { margin-left: 4px; }
.ent-list[hidden] { display: none; }
.ent-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; margin: -2px 0 12px; }
.ent-name { text-align: center; padding: 12px 6px; background: #fff; border: 1px solid var(--acc); border-radius: 10px; color: var(--acc); font-weight: 700; font-size: 16px; text-decoration: none; }
.cal { max-width: 1000px; margin: 0 auto; }
.cal-head, .cal-week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 2px; }
.cal-head div { text-align: center; font-size: 12px; font-weight: 700; padding: 4px 0; color: var(--fg2); }
.cal-head .sun { color: #c0392b; } .cal-head .sat { color: #2c6fb7; }
.cal-week { margin-bottom: 2px; }
.cal-week { position: relative; align-content: start; }
.cal-cell { min-width: 0; min-height: 64px; background: #fff; border: 1px solid var(--border); border-radius: 6px; cursor: pointer; overflow: hidden; z-index: 0; }
.cal-d { z-index: 1; padding: 2px 4px; cursor: pointer; align-self: start; }
.cal-bar { z-index: 2; align-self: start; margin: 1px 3px; padding: 1px 5px; font-size: 11px; line-height: 1.35; border-radius: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff; background: var(--c); border: 1px solid var(--c); cursor: pointer; min-width: 0; }
.cal-bar.work { background: #fff; color: var(--c); }
.cal-bar.dflt { opacity: .4; }
.cal-cell.blank { background: transparent; border-color: transparent; cursor: default; }
.cal-cell.today { border-color: var(--acc); box-shadow: 0 0 0 1px var(--acc); }
.cal-cell.sel { background: #fffbe8; box-shadow: 0 0 0 2px #e0a020; }
.cal-d { font-size: 13px; font-weight: 700; display: flex; align-items: baseline; gap: 3px; min-width: 0; }
.cal-d.sun { color: #c0392b; } .cal-d.sat { color: #2c6fb7; }
.cal-hol { font-size: 9px; font-weight: 400; color: #c0392b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.cal-nt { font-size: 9px; font-weight: 400; color: #8a6d00; margin-left: auto; white-space: nowrap; }
.nt-box { margin-top: 8px; border-top: 1px dashed var(--border); padding-top: 8px; }
.nt { display: flex; gap: 8px; align-items: baseline; padding: 3px 0; font-size: 14px; }
.nt-by { flex: 0 0 auto; font-size: 12px; font-weight: 700; color: #fff; background: #8a6d00; border-radius: 6px; padding: 0 6px; }
.nt-body { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.nt-del { border: 0; background: transparent; color: var(--fg2); font-size: 16px; cursor: pointer; padding: 0 4px; }
.nt-form { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
.nt-form select, .nt-form input { font-size: 16px; padding: 7px 8px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; }
.nt-form input { flex: 1; min-width: 140px; }
.cal-legend { display: flex; gap: 12px; flex-wrap: wrap; font-size: 12px; color: var(--fg2); margin: 8px 2px; }
.cal-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; vertical-align: -1px; margin-right: 3px; background: var(--acc); }
.cal-legend i.rich { background: #3b7dd8; } .cal-legend i.off { background: #b5b5b5; }
.sh-detail { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; margin: 10px 0; }
.sh-date { font-weight: 700; margin-bottom: 6px; }
.sh-date .sun { color: #c0392b; } .sh-date .sat { color: #2c6fb7; }
.sh-date small { font-weight: 400; color: #c0392b; margin-left: 6px; }
.sh-row { display: flex; gap: 8px; padding: 3px 0; align-items: baseline; }
.sh-store { flex: 0 0 52px; font-size: 12px; font-weight: 700; color: #fff; background: var(--acc); border-radius: 6px; text-align: center; padding: 2px 0; }
.sh-store.rich { background: #3b7dd8; }
.sh-store.off { background: #9a9a9a; }
.sh-people { flex: 1; display: flex; flex-wrap: wrap; gap: 4px 8px; }
.sh-p { font-size: 15px; }
.sh-tag { font-size: 11px; border-radius: 5px; padding: 0 5px; margin-left: 3px; vertical-align: 1px; }
.sh-tag.help { background: #e8f0fe; color: #1a56b0; border: 1px solid #b9cdf5; }
.sh-tag.chg { background: #fde8e8; color: #b3261e; border: 1px solid #f2b8b5; }
.sh-none { color: var(--fg2); font-size: 14px; }
.sh-foot { display: flex; gap: 10px; margin: 14px 0 30px; }
.sh-foot a { flex: 1; text-align: center; padding: 12px; border: 1px solid var(--acc); border-radius: 10px; color: var(--acc); text-decoration: none; font-weight: 600; background: #fff; }
@media (max-width: 560px) { .cal-cell { min-height: 70px; } .cal-bar { font-size: 9px; margin: 1px 1px; padding: 0 2px; } .cal-d { font-size: 12px; padding: 1px 2px; } .cal-hol { font-size: 8px; } }

/* Screen-only calendar styling; the existing monochrome print layout is retained. */
@media screen {
 main:has(.cal) {max-width:1180px;padding:24px 20px 40px}
 .back-link {font-size:13px;margin-bottom:20px!important}
 .sc-top,.sh-top {flex-wrap:wrap;gap:18px;margin:0 0 22px}
 .sc-top h1,.sh-top h1 {font-size:24px;letter-spacing:.03em}
 .sh-nav {gap:14px}
 .sh-nav b {font-size:17px;font-weight:500;font-variant-numeric:tabular-nums;min-width:100px;text-align:center}
 .sh-nav a {display:grid;place-items:center;width:42px;height:42px;padding:0;border-radius:50%;font-size:25px;line-height:1}
 .sh-nav a:hover {background:var(--soft)}
 .sh-nav a:focus-visible,.cal-d:focus-visible {outline:3px solid var(--acc);outline-offset:2px}
 .cal {max-width:none;background:#fff;border:1px solid var(--border);border-radius:20px;padding:12px;box-shadow:0 4px 20px #24324504}
 .cal-head {padding-bottom:8px}
 .cal-head div {font-size:12px;font-weight:500;padding:8px 0;letter-spacing:.04em}
 .cal-head,.cal-week {gap:4px}
 .cal-week {margin-bottom:4px}
 .cal-cell {border-color:var(--border);border-radius:10px;background:#fff}
 .cal-cell.blank {background:#f8f9fb;border-color:transparent}
 .cal-cell.today {background:#fcfaf3;border-color:var(--gold);box-shadow:inset 0 0 0 1px var(--gold)}
 .cal-d {font-size:14px;font-weight:600;min-height:30px;padding:4px 5px;line-height:1.5}
 .cal-hol {font-size:10px}
 .cal-cell.sel {background:#f8f1df;border-color:var(--gold);box-shadow:inset 0 0 0 2px var(--gold)}
 .sc-sharing {padding:16px 18px;border-radius:16px;margin:0 0 16px;flex-wrap:wrap}
 .sc-sharing strong {font-size:14px;font-weight:600}
 .sc-state {background:var(--soft);color:var(--fg)}
 .sc-sharing p {line-height:1.8}
 .sc-sharing a {background:var(--soft);color:var(--acc);font-weight:500}
 .sc-hint {line-height:1.8;margin-bottom:16px}
 .sh-bar {gap:12px;margin:0 0 18px}
 .ent-btn {background:#fff;padding:10px 14px;color:var(--fg);border-radius:12px}
 .sh-detail {border-radius:14px;background:#f8fafc;padding:18px;margin:18px 0 0;line-height:1.8}
 .sh-date {font-size:16px;margin-bottom:12px}
 .sh-row {padding:5px 0}
 .cal-legend {gap:8px 14px;line-height:1.8;padding:10px 4px;margin:8px 0 0}
 .sh-foot a {border-color:var(--border);border-radius:14px;padding:16px;background:var(--acc);color:#fff}
 .nt-form input {background:#fff}
 @media(max-width:560px){
  main:has(.cal){padding:18px 10px 30px}
  .sc-top,.sh-top {gap:14px;margin-bottom:18px}
  .sc-top h1,.sh-top h1 {font-size:22px;width:100%}
  .sh-nav {width:100%;justify-content:space-between}
  .sh-nav b {font-size:18px}
  .cal {padding:6px;border-radius:16px}
  .cal-head,.cal-week {gap:2px}
  .cal-week {margin-bottom:2px}
  .cal-cell {border-radius:6px}
  .cal-d {font-size:13px;padding:3px 2px;min-height:27px;flex-wrap:wrap;gap:0 2px}
  .cal-hol {font-size:9px;max-width:100%}
  .sc-sharing {padding:14px;gap:10px}
  .sc-sharing p {font-size:12px}
  .sh-detail {padding:14px 10px}
 }
}

@media screen {
 .cal-cell {min-height:94px}
 .cal-bar {font-size:12px;line-height:1.65;padding:2px 5px;margin:2px 3px;border-radius:5px}
 .cal-bar.dflt {opacity:1;border-style:dashed}
 .cal-nt {color:#686868}
 @media(max-width:560px){.cal-cell{min-height:90px}.cal-bar{font-size:11px;line-height:1.6;padding:1px 2px;margin:2px 1px}}
}

.shift-views {display:flex;gap:6px;padding:5px;background:#f2f2f2;border-radius:14px;margin:16px 0}
.shift-views a {flex:1;text-align:center;padding:12px 6px;border:1px solid transparent;border-radius:10px;color:var(--fg2);font-weight:600;font-size:14px;text-decoration:none}
.shift-views a[aria-current=page] {background:#fff;border-color:var(--gold);color:var(--fg);box-shadow:0 2px 5px #00000008}
.shift-view-hint {font-size:13px;line-height:1.7;color:var(--fg2);margin:0 0 18px}
.sh-hours {font-size:12px;color:var(--fg2);margin-left:4px}
@media print {.shift-views,.shift-view-hint {display:none!important}}
@media screen {
 .cal-bar,.cal-bar.work,.cal-bar.rest {background:#f4f4f4;color:#3d3d3d;border:1px solid #c9c9c9}
 .cal-bar.dflt {border-style:dashed}
 .cal-bar.help {background:#fbf7ed;border-color:var(--gold);color:#5e4c26}
 .sh-store.rich,.sh-store.off {background:#707070}
 .sh-tag.help {background:#f5f1e7;border-color:var(--border);color:#5e4c26}
 .sh-tag.chg {background:#f0f0f0;border-color:#ccc;color:#4b4b4b}
}
.cal-bar {white-space:normal;overflow-wrap:anywhere;text-overflow:clip}
.cal-person {display:block;font-weight:600}
.cal-location {display:block;font-size:10px;font-weight:400;line-height:1.5}
@media screen {.cal-bar {padding:4px 3px;line-height:1.5}}
.cal-counts {z-index:2;min-width:0;padding:3px 2px 6px;font-size:10px;line-height:1.7;color:#555;cursor:pointer}
.cal-counts span {display:block;white-space:normal;overflow-wrap:anywhere;line-height:1.4;margin-bottom:5px}
.cal-counts {overflow:hidden;max-width:100%;box-sizing:border-box}
.cal-counts b {display:inline-block;font-size:12px}
.cal-counts b {font-weight:700;color:#303030}
.sh-counts {font-size:15px;padding:8px 0 12px;margin-bottom:8px;border-bottom:1px solid var(--border);font-weight:600}
@media(min-width:700px){.cal-counts{font-size:12px;padding:4px 6px 8px}}
.cal-change-count{display:block;flex-basis:100%;min-width:0;box-sizing:border-box;font-size:9px;color:#705a27;background:#faf3df;border:1px solid var(--border);border-radius:4px;padding:1px;line-height:1.5;letter-spacing:0;white-space:nowrap}
.cal-d{flex-wrap:wrap}
.cal-change-tag,.cal-change-time{display:block;font-size:10px;line-height:1.5;overflow-wrap:anywhere}
.cal-change-tag{color:#705a27}
.sh-exceptions{border:1px solid var(--border);border-radius:10px;background:#fcf9f0;padding:12px;margin-bottom:14px;font-size:14px;line-height:1.9}
@media screen{.cal-bar.exception{background:#fcf8ed;border:1px solid var(--gold)}}
/* 日付ごとに独立して積む。別の日の長い勤務表示で空白を作らない。 */
.cal-week {align-items:stretch}
.cal-cell {padding:3px;overflow:visible}
.cal-people {display:flex;flex-direction:column;gap:5px}
.cal-people .cal-bar {margin:0;padding:4px 3px;min-width:0;outline:none;font-size:11px;line-height:1.5}
.cal-people .cal-location {font-size:10px}
.cal-change-time {font-size:10px;font-weight:500;line-height:1.5}
.cal-counts {padding:5px 0 7px;font-size:9px;line-height:1.5}
.cal-counts span {margin-bottom:3px}
.cal-counts b {display:block;font-size:12px}
.cal-d {font-size:14px}
@media(min-width:700px){.cal-people .cal-bar{font-size:13px;padding:6px}.cal-counts b{display:inline}.cal-counts{font-size:12px}.cal-counts span{display:inline-block;margin-right:10px}}
/* 名前と店舗名は同じ文字サイズ・行間でそろえる。 */
.cal-people .cal-person,.cal-people .cal-location {font-size:10px;font-weight:400;line-height:1.6}
@media(min-width:700px){.cal-people .cal-person,.cal-people .cal-location{font-size:12px}}
.ent-btn{min-height:48px;padding:12px 16px;font-size:14px;line-height:1.5}
.ent-list{gap:10px;margin:4px 0 20px}.ent-name{min-height:48px;display:flex;align-items:center;justify-content:center;padding:12px}
.sh-foot{flex-wrap:wrap;gap:12px}.sh-foot a{min-height:48px;flex:1 1 220px}
/* 通常の名前・店舗の2行は同じ高さ。変更内容は省略せず必要な分を確保。 */
.cal-people .cal-bar {min-height:44px;padding:5px 3px;box-sizing:border-box}
.cal-people .cal-person,.cal-people .cal-location {min-height:16px;line-height:16px;margin:0}
@media(min-width:700px){.cal-people .cal-bar{min-height:48px}.cal-people .cal-person,.cal-people .cal-location{min-height:18px;line-height:18px}}
/* 名前の長さではなく、その日の列幅いっぱいに枠をそろえる。 */
.cal-people {align-items:stretch}
.cal-people .cal-bar {align-self:stretch;width:100%;max-width:100%;min-width:0;box-sizing:border-box}
.cal-closed{display:block;flex-basis:100%;font-size:10px;color:#b23f3f;line-height:1.5}.cal-people .rest-name{color:#b23f3f;white-space:nowrap;letter-spacing:0;font-size:9px}.cal-people .cal-bar.rest{padding-left:1px;padding-right:1px}@media(min-width:700px){.cal-people .rest-name{font-size:12px}}
/* 週内で日付欄・人数欄の高さを共有し、どの曜日も同じ段から名簿を始める。 */
@media screen {
  .cal-week {grid-template-rows:auto auto 1fr;row-gap:0}
  .cal-cell {display:grid;grid-row:span 3;grid-template-rows:subgrid}
  .cal-counts {grid-row:2}
  .cal-people {grid-row:3;align-self:start}
}
</style>
{% endblock %}
{% block content %}
<p class="back-link" style="margin-bottom:8px"><a href="/">← トップにもどる</a></p>
<div class="sh-top">
  <h1>出勤一覧</h1>
  <div class="sh-nav">
    <a href="/shift?month={{ nav.prev }}&view={{ view }}" aria-label="前の月">‹</a>
    <b>{{ nav.label }}</b>
    <a href="/shift?month={{ nav.next }}&view={{ view }}" aria-label="次の月">›</a>
  </div>
</div>
<div class="shift-views no-print" aria-label="カレンダーの表示切り替え">
<a href="/shift?month={{ nav.month }}&view=all"{% if view == 'all' %} aria-current="page"{% endif %}>出勤スケジュール</a>
<a href="/shift?month={{ nav.month }}&view=changes"{% if view != 'all' %} aria-current="page"{% endif %}>休みスケジュール</a>
</div>
<p class="shift-view-hint no-print">{% if view == 'all' %}勤務日に登録した休みは「名前＋休み」で表示します。日付を押すと勤務時間を確認できます。{% else %}個別に登録した休みを表示します。通常の勤務日・定休日は表示しません。{% endif %}</p>
<div class="sh-bar">
  <div class="sh-stamp">{% if last_at %}最終入力 <b>{{ last_at }}</b>{% else %}まだ入力はありません{% endif %}</div>
  <span style="display:flex;gap:6px">{% if staff %}<button type="button" id="ent-btn" class="ent-btn" aria-expanded="false" aria-controls="ent-list">出勤・休みを登録／変更 ▾</button>{% endif %}</span>
</div>
{% if staff %}
<div id="ent-list" class="ent-list" hidden>
  {% for s in staff %}<a class="ent-name" data-sid="{{ s.id }}" href="/shift/edit?month={{ nav.month }}&staff={{ s.id }}">{{ s.name }}</a>{% endfor %}
</div>
{% else %}
<p style="color:var(--fg2);margin:14px 0">まだスタッフが登録されていません。「設定」→「スタッフ登録・設定」から登録してください。</p>
{% endif %}
<div class="cal">
  <div class="cal-head"><div>月</div><div>火</div><div>水</div><div>木</div><div>金</div><div class="sat">土</div><div class="sun">日</div></div>
  {% for week in weeks %}
  <div class="cal-week">
    {% for day in week %}
    {% if day %}
    <div class="cal-cell{% if day.today %} today{% endif %}" data-date="{{ day.date }}">
      <div class="cal-d{% if day.sun %} sun{% elseif day.sat %} sat{% endif %}" data-date="{{ day.date }}">{{ day.d }}{% if day.closed %}<span class="cal-closed">店休日</span>{% endif %}{% if day.hol %}<span class="cal-hol">{{ day.hol }}</span>{% endif %}{% if day.exceptions %}<span class="cal-change-count">変更{{ day.exceptions|length }}件</span>{% endif %}</div>
      {% if view == 'all' %}<div class="cal-counts" data-date="{{ day.date }}"><span>イノ <b>{{ day.groups['イノ']|length }}人</b></span><span>リッチ <b>{{ day.groups['リッチ']|length }}人</b></span></div>{% endif %}
      <div class="cal-people">
      {% for store, people in day.groups %}{% for p in people %}
      <div class="cal-bar {{ store == '休' ? 'rest' : 'work' }}{% if p.default %} dflt{% endif %}{% if p.difference %} exception{% endif %}" data-date="{{ day.date }}" data-sid="{{ p.id }}"><span class="cal-person{% if store == '休' %} rest-name{% endif %}">{{ p.name }}{% if store == '休' %}休み{% endif %}</span>{% if store != '休' %}<small class="cal-location">{{ store }}</small>{% endif %}
      {% if p.partial_off %}<small class="cal-change-time">{{ p.off_hours }}時休み</small>
      {% elseif store == '休' and p.time_s %}<small class="cal-change-time">{{ p.time_s }}時</small>
      {% else %}{% for tag in p.difference %}{% if not (store == '休' and tag in ['休み','一部休み']) and not (p.work_note and tag in ['休日出勤','時間変更']) %}<small class="cal-change-tag">{{ tag }}</small>{% endif %}{% endfor %}{% if p.work_note %}<small class="cal-change-time">{{ p.work_note }}</small>{% endif %}{% endif %}</div>
      {% endfor %}{% endfor %}
      </div>
      <div class="cal-detail" hidden>
        <div class="sh-date">{{ nav.label|slice(5) }}{{ day.d }}日 <span class="{% if day.sun %}sun{% elseif day.sat %}sat{% endif %}">（{{ day.w }}）</span>{% if day.hol %}<small>{{ day.hol }}</small>{% endif %}</div>
        {% if view == 'all' %}<div class="sh-counts">イノ {{ day.groups['イノ']|length }}人 ／ リッチ {{ day.groups['リッチ']|length }}人</div>{% endif %}
        {% if day.exceptions %}<div class="sh-exceptions"><b>基本シフトからの変更</b>{% for e in day.exceptions %}<div>{{ e.name }}：{{ e.tags|join('・') }}{% if e.store != '休' %}（{{ e.store }}）{% endif %}{% if e.hours %} {{ e.hours }}{% endif %}</div>{% endfor %}</div>{% endif %}
        {% for store, people in day.groups %}{% if people %}
        <div class="sh-row">
          <span class="sh-store{% if store == 'リッチ' %} rich{% elseif store == '休' %} off{% endif %}">{{ store }}</span>
          <span class="sh-people">
            {% for p in people %}<span class="sh-p" data-sid="{{ p.id }}">{{ p.name }}{% if p.hours %}<span class="sh-hours">{{ p.hours }}</span>{% endif %}{% if p.help %}<span class="sh-tag help">{{ p.from }}から</span>{% endif %}{% if p.time_l %}<span class="sh-tag help">{{ p.time_l }}だけ休み</span>{% endif %}{% if p.changed %}<span class="sh-tag chg">変更</span>{% endif %}</span>{% endfor %}
          </span>
        </div>
        {% endif %}{% endfor %}
        {% if not day.any %}<div class="sh-none">個別の予定はありません</div>{% endif %}
        <div class="nt-box">
          {% for n in day.notes %}<div class="nt"><span class="nt-by">{{ n.author ?: '—' }}</span><span class="nt-body">{{ n.body }}</span><button type="button" class="nt-del" data-id="{{ n.id }}" aria-label="メモを消す">×</button></div>{% endfor %}
          <form class="nt-form" data-date="{{ day.date }}">
            <select class="nt-who">{% for st in staff %}<option value="{{ st.name }}" data-sid="{{ st.id }}">{{ st.name }}</option>{% endfor %}</select>
            <input class="nt-text" maxlength="300" placeholder="メモ（例: 12時半から出ます）" required>
            <button type="submit" class="btn btn-sm">書く</button>
          </form>
        </div>
      </div>
    </div>
    {% else %}<div class="cal-cell blank"></div>{% endif %}
    {% endfor %}
  </div>
  {% endfor %}
  <div class="cal-legend"><span>店名＝勤務店舗</span><span>点線＝基本設定</span><span>ヘルプ＝別店舗への出勤</span><span style="color:#c0392b">赤＝日曜・祝日</span></div>
  <div class="sh-detail" id="detail"><div class="sh-none">日をタップすると、くわしく出ます</div></div>
</div>
<div class="sh-foot">
  <a href="/shift/edit?month={{ nav.month }}">出勤・休みを登録／変更</a>
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
  const btn = document.getElementById('ent-btn'), list = document.getElementById('ent-list');
  const detail = document.getElementById('detail');
  const cells = [...document.querySelectorAll('.cal-cell[data-date]')];
  const cellOf = d => cells.find(x => x.dataset.date === d);
  let me = '';
  try { me = localStorage.getItem('shift:me') || ''; } catch (e) {}
  function show(c) {
    cells.forEach(x => x.classList.toggle('sel', x === c));
    detail.innerHTML = c.querySelector('.cal-detail').innerHTML;
    paintWho();
  }
  document.querySelectorAll('.cal-cell[data-date], .cal-d[data-date], .cal-bar[data-date], .cal-counts[data-date]').forEach(e => e.addEventListener('click', () => { const c = cellOf(e.dataset.date); if (c) show(c); }));
  if (btn) btn.addEventListener('click', () => { list.hidden = !list.hidden; btn.setAttribute('aria-expanded', String(!list.hidden)); });
  document.querySelectorAll('.ent-name').forEach(a => a.addEventListener('click', () => { try { localStorage.setItem('shift:me', a.dataset.sid); } catch (e) {} }));
  function paintWho() {
    detail.querySelectorAll('.nt-who').forEach(sel => { [...sel.options].forEach(o => { if (me !== '' && o.dataset.sid === me) sel.value = o.value; }); });
  }
  const post = (url, body) => fetch(url, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)}).then(r => r.json());
  detail.addEventListener('submit', async e => {
    const f = e.target.closest('.nt-form'); if (!f) return;
    e.preventDefault();
    const text = f.querySelector('.nt-text').value.trim(); if (!text) return;
    try {
      const j = await post('/api/shift/note', {date: f.dataset.date, author: f.querySelector('.nt-who').value, body: text});
      if (!j.ok) throw 0;
      location.hash = f.dataset.date; location.reload();
    } catch (err) { alert('書き込めませんでした。もう一度お試しください'); }
  });
  detail.addEventListener('click', async e => {
    const b = e.target.closest('.nt-del'); if (!b) return;
    if (!confirm('このメモを消しますか？')) return;
    const f = detail.querySelector('.nt-form');
    try {
      const j = await post('/api/shift/note/delete', {id: +b.dataset.id});
      if (!j.ok) throw 0;
      location.hash = f ? f.dataset.date : ''; location.reload();
    } catch (err) { alert('消せませんでした。もう一度お試しください'); }
  });
  const hashDate = (location.hash || '').slice(1);
  const t = cellOf(hashDate) || document.querySelector('.cal-cell.today');
  if (t) show(t);
})();
</script>
{% endblock %}
