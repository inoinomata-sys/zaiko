<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ nav.label }} {{ store }} スタイリストのお休み</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#ececec;color:#303333;font-family:'Hiragino Sans','Meiryo',sans-serif}.tools{max-width:980px;margin:20px auto;display:flex;flex-wrap:wrap;align-items:center;gap:12px;padding:0 16px;font-size:14px}.tools a{color:#555}.tools form{display:flex;flex-wrap:wrap;gap:10px;align-items:center}button,input,select{font:inherit;padding:10px 12px;border:1px solid #cbb780;border-radius:9px;background:#fff;color:#333}.print-button{background:#555;color:white;border:0;cursor:pointer}.print-hint{max-width:900px;margin:12px auto;font-size:13px;color:#666;padding:0 16px;line-height:1.8}
.sheet{--accent:{{ theme.color }};--tint:{{ theme.soft }};width:210mm;min-height:148mm;margin:20px auto;background:#fff;padding:6mm;box-shadow:0 4px 25px #0001;position:relative}.page-head{height:22mm;display:flex;align-items:center;gap:5mm;border-bottom:1px solid var(--accent);position:relative;overflow:hidden}.month-no{font-family:Georgia,serif;font-size:47pt;color:var(--accent);line-height:1;letter-spacing:-2px}.month-meta{min-width:31mm}.month-en{font-family:Georgia,serif;font-size:15pt;color:var(--accent)}.year{font-size:8pt;letter-spacing:2px;margin-top:2mm}.page-title{margin-left:2mm;z-index:1}.page-title h1{font-size:16pt;font-weight:500;letter-spacing:1px;margin:0 0 2mm}.page-title p{font-size:9pt;margin:0;color:#666}.brand{font-size:8pt;letter-spacing:1.2px;margin-top:3mm}.art{position:absolute;right:0;top:0;width:44mm;height:25mm;color:var(--accent);opacity:.65}.art svg{width:100%;height:100%}
.calendar{margin-top:3mm}.weekdays,.week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}.weekdays{height:5mm}.weekdays span{text-align:center;font-size:7pt;color:#727272}.weekdays .sun{color:#ad6766}.weekdays .sat{color:#688397}.week{min-height:{{ weeks|length == 6 ? '14.2' : '16.8' }}mm;border-top:1px solid #e6e2d9}.day{min-width:0;padding:1mm 1.2mm .8mm;border-right:1px solid #eeeae3}.day:first-child{border-left:1px solid #eeeae3}.day.blank{background:#fafafa}.day-number{font-size:8pt;font-weight:500;display:flex;gap:1mm;align-items:baseline;margin-bottom:.7mm}.day-number.sun{color:#ad6766}.day-number.sat{color:#688397}.holiday{font-size:5pt;font-weight:400;line-height:1.2}.names{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5mm 1mm;align-content:start}.person{min-width:0;font-size:6.5pt;line-height:1.15;overflow-wrap:anywhere}.person.partial{grid-column:1/-1;color:var(--accent)}.person small{font-size:5.7pt}.page-foot{border-top:1px solid var(--accent);margin-top:1mm;padding-top:1.5mm;display:flex;gap:4mm;justify-content:space-between;font-size:6.2pt;color:#666;line-height:1.6}.page-foot strong{font-weight:500;color:#444}.screen-scroll{overflow-x:auto}
@page{size:A5 landscape;margin:0}@media print{body{background:white}.tools,.print-hint{display:none!important}.screen-scroll{overflow:visible}.sheet{width:210mm;height:148mm;min-height:0;margin:0;box-shadow:none;break-after:page;overflow:visible}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style></head><body>
<div class="tools"><a href="/shift?month={{ nav.month }}">← 出勤一覧</a><form method="get"><label>月 <input type="month" name="month" value="{{ nav.month }}" required></label><button>表示</button></form><a class="print-button" href="/shift/customer.pdf?month={{ nav.month }}" style="padding:12px;border-radius:9px;text-decoration:none;color:#fff">PDFを開いて印刷・保存</a></div>
<p class="print-hint">お客様向けのお休み表です。印刷は「A5・横向き・倍率100%・ヘッダーとフッターなし」で設定してください。背景のグラフィックを有効にすると季節の色も印刷されます。</p>
{% if staff_count is defined and staff_count == 0 %}<p class="print-hint" role="alert">掲載対象のスタイリストが未設定です。「設定」→「スタッフ登録・設定」で職種を選んでから印刷してください。</p>{% endif %}
<div class="screen-scroll"><article class="sheet">
<header class="page-head"><div class="month-no">{{ '%02d'|format(month_number) }}</div><div class="month-meta"><div class="month-en">{{ theme.en }}</div><div class="year">{{ year }}</div></div><div class="page-title"><h1>スタイリストのお休み</h1><p>{{ store }}店</p><div class="brand">INO Inc. / Store Management</div></div><div class="art" aria-label="{{ theme.name }}">{% include 'shift_season_art.twig' %}</div></header>
<section class="calendar"><div class="weekdays"><span>MON</span><span>TUE</span><span>WED</span><span>THU</span><span>FRI</span><span class="sat">SAT</span><span class="sun">SUN</span></div>
{% for week in weeks %}<div class="week">{% for day in week %}<div class="day{% if not day %} blank{% endif %}">{% if day %}<div class="day-number{% if day.sun %} sun{% elseif day.sat %} sat{% endif %}">{{ day.d }}{% if day.hol %}<span class="holiday">{{ day.hol }}</span>{% endif %}</div><div class="names">{% for p in day.holidays %}<div class="person{% if not p.full %} partial{% endif %}">{{ p.name }}{% if p.note %} <small>{{ p.note }}</small>{% endif %}</div>{% endfor %}</div>{% endif %}</div>{% endfor %}</div>{% endfor %}</section>
<footer class="page-foot"><div><strong>お名前の記載がある日は、そのスタイリストのお休みです。</strong><br>時間の記載がある場合は、一部のお休み・勤務時間の変更です。</div><div>ご予約の際にご確認ください。<br>予定が変更になる場合がございます。</div></footer>
</article></div></body></html>
