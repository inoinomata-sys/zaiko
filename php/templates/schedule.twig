{% extends 'base.twig' %}
{% block title %}店舗スケジュール{% endblock %}
{% block head %}
<style>
@page { size: A4 landscape; margin: 8mm; }
@media print {
  nav, #pwa-banner, #to-top, #toast, .no-print, .sh-bar, .ent-list, #detail, .sh-foot, .back-link, .sh-nav a { display: none !important; }
  body, main { background: #fff !important; padding: 0 !important; margin: 0 !important; max-width: none !important; }
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .cal { max-width: none; }
  .cal-cell { min-height: 27mm; font-size: 10pt; border-color: #999; break-inside: avoid; box-shadow: none !important; background: #fff !important; }
  .cal-d { font-size: 12pt; }
  .cal-hol { font-size: 8pt; }
  .cal-p { font-size: 10pt; }
  .cal-t { font-size: 8pt; }
  .cal-ev { font-size: 9pt; }
  .cal-head div { font-size: 10pt; }
  h1 { font-size: 16pt !important; }
  /* 白黒印刷：色に頼らず、文字と線で見分ける */
  html, body, main, * { color: #000 !important; }
  .cal-cell { border: 1px solid #000 !important; border-radius: 0 !important; }
  .cal-cell[data-add-url]{cursor:pointer}
.cal-cell.blank { border-color: transparent !important; }
  .cal-cell.today { border-width: 2px !important; }
  .cal-d.sun { background: #ddd !important; }
  .cal-d.sun .cal-hol, .cal-hol { font-weight: 700; }
  .cal-g { border-left: 3px solid #000 !important; }
  .cal-g.rich { border-left: 3px dashed #000 !important; }
  .cal-g.off { border-left: 3px dotted #000 !important; }
  .cal-g.off .cal-p { text-decoration: line-through; }
  .cal-g.off .cal-p .cal-t { text-decoration: none; }
  .cal-p.me { background: none !important; font-weight: 400 !important; }
  .cal-st { display: inline !important; font-weight: 700; font-size: 8pt; }
  .cal-ev { border-left: 3px solid #000 !important; }

  .sh-top { margin-bottom: 4mm; }
}
.sc-sharing{display:flex;justify-content:space-between;align-items:center;gap:12px;background:#fff;border:1px solid var(--border);border-radius:14px;padding:14px 18px;margin:12px 0}.sc-sharing p{font-size:13px;margin:5px 0 0;color:var(--fg2)}.sc-sharing a{white-space:nowrap;padding:10px 12px;border-radius:10px;background:#eaf5eb;color:#22633c;text-decoration:none;font-weight:700}.sc-state{font-size:12px;margin-left:8px;background:#f3eee0;padding:3px 8px;border-radius:999px}.sc-hint{font-size:13px;color:var(--fg2);margin:12px 0}.cal-d{text-decoration:none;color:inherit;min-height:28px}.sc-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
.sc-top h1 { font-size: 20px; font-weight: 700; }
.sh-nav { display: flex; align-items: center; gap: 6px; }
.sh-nav a { padding: 7px 12px; border: 1px solid var(--border); border-radius: 10px; background: #fff; color: var(--fg); text-decoration: none; }
.ent-btn { font-size: 13px; padding: 5px 12px; border: 1px solid var(--border); border-radius: 999px; background: transparent; color: var(--fg2); font-family: inherit; cursor: pointer; }
.cal { max-width: 1200px; margin: 0 auto; }
.cal-head, .cal-week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 2px; }
.cal-head div { text-align: center; font-size: 12px; font-weight: 700; padding: 4px 0; color: var(--fg2); }
.cal-head .sun { color: #c0392b; } .cal-head .sat { color: #2c6fb7; }
.cal-week { margin-bottom: 2px; }
.cal-cell { min-width: 0; min-height: 112px; background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 2px 3px 3px; font-size: 12px; line-height: 1.5; overflow: hidden; }
.cal-cell.blank { background: transparent; border-color: transparent; }
.cal-cell.today { border-color: var(--acc); box-shadow: 0 0 0 1px var(--acc); }
.cal-d { font-size: 13px; font-weight: 700; display: flex; align-items: baseline; gap: 3px; }
.cal-d.sun { color: #c0392b; } .cal-d.sat { color: #2c6fb7; }
.cal-hol { font-size: 9px; font-weight: 400; color: #c0392b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.cal-ev { margin-top: 2px; padding-left: 3px; border-left: 3px solid var(--acc); overflow-wrap: anywhere; }
.cal-ev small { color: var(--fg2); margin-left: 2px; }
@media (max-width: 560px) { .cal-cell { min-height: 80px; padding: 1px; font-size: 9px; } .cal-d { font-size: 12px; } .cal-hol { font-size: 8px; } }

/* Screen-only calendar styling; the existing monochrome print layout is retained. */
@media screen {
 main:has(.cal) {max-width:1180px;padding:24px 20px 40px}
 .back-link {font-size:13px;margin-bottom:20px!important}
 .sc-top,.sh-top {flex-wrap:wrap;gap:18px;margin:0 0 22px}
 .sc-top h1,.sh-top h1 {font-size:24px;letter-spacing:.03em}
 .sh-nav {gap:14px}
 .sh-nav b {font-size:17px;font-weight:500;font-variant-numeric:tabular-nums;min-width:100px;text-align:center}
 .sh-nav a {display:grid;place-items:center;width:42px;height:42px;padding:0;border-radius:50%;font-size:25px;line-height:1}
 .sh-nav a:hover {background:var(--soft)}
 .sh-nav a:focus-visible,.cal-d:focus-visible {outline:3px solid var(--acc);outline-offset:2px}
 .cal {max-width:none;background:#fff;border:1px solid var(--border);border-radius:20px;padding:12px;box-shadow:0 4px 20px #24324504}
 .cal-head {padding-bottom:8px}
 .cal-head div {font-size:12px;font-weight:500;padding:8px 0;letter-spacing:.04em}
 .cal-head,.cal-week {gap:4px}
 .cal-week {margin-bottom:4px}
 .cal-cell {border-color:var(--border);border-radius:10px;background:#fff}
 .cal-cell.blank {background:#f8f9fb;border-color:transparent}
 .cal-cell.today {background:#fcfaf3;border-color:var(--gold);box-shadow:inset 0 0 0 1px var(--gold)}
 .cal-d {font-size:14px;font-weight:600;min-height:30px;padding:4px 5px;line-height:1.5}
 .cal-hol {font-size:10px}
 .cal-cell.sel {background:#f8f1df;border-color:var(--gold);box-shadow:inset 0 0 0 2px var(--gold)}
 .sc-sharing {padding:16px 18px;border-radius:16px;margin:0 0 16px;flex-wrap:wrap}
 .sc-sharing strong {font-size:14px;font-weight:600}
 .sc-state {background:var(--soft);color:var(--fg)}
 .sc-sharing p {line-height:1.8}
 .sc-sharing a {background:var(--soft);color:var(--acc);font-weight:500}
 .sc-hint {line-height:1.8;margin-bottom:16px}
 .sh-bar {gap:12px;margin:0 0 18px}
 .ent-btn {background:#fff;padding:10px 14px;color:var(--fg);border-radius:12px}
 .sh-detail {border-radius:14px;background:#f8fafc;padding:18px;margin:18px 0 0;line-height:1.8}
 .sh-date {font-size:16px;margin-bottom:12px}
 .sh-row {padding:5px 0}
 .cal-legend {gap:8px 14px;line-height:1.8;padding:10px 4px;margin:8px 0 0}
 .sh-foot a {border-color:var(--border);border-radius:14px;padding:16px;background:var(--acc);color:#fff}
 .nt-form input {background:#fff}
 @media(max-width:560px){
  main:has(.cal){padding:18px 10px 30px}
  .sc-top,.sh-top {gap:14px;margin-bottom:18px}
  .sc-top h1,.sh-top h1 {font-size:22px;width:100%}
  .sh-nav {width:100%;justify-content:space-between}
  .sh-nav b {font-size:18px}
  .cal {padding:6px;border-radius:16px}
  .cal-head,.cal-week {gap:2px}
  .cal-week {margin-bottom:2px}
  .cal-cell {border-radius:6px}
  .cal-d {font-size:13px;padding:3px 2px;min-height:27px;flex-wrap:wrap;gap:0 2px}
  .cal-hol {font-size:9px;max-width:100%}
  .sc-sharing {padding:14px;gap:10px}
  .sc-sharing p {font-size:12px}
  .sh-detail {padding:14px 10px}
 }
}

@media screen {
 .cal-cell {min-height:128px;padding:3px 4px 8px;font-size:13px;line-height:1.65}
 .cal-ev {margin:4px 0;padding:4px 5px;border-left:2px solid #929292;border-radius:3px;background:#f4f4f4;color:#303030;line-height:1.6}
 .cal-ev small {display:block;font-size:11px;margin-left:0;color:#686868}
 @media(max-width:560px){.cal-cell{min-height:104px;padding:1px 2px 5px;font-size:11px}.cal-ev{padding:3px 2px;margin:3px 0}.cal-ev small{font-size:10px}}
}
.sc-closed{font-size:11px;color:#b23f3f;line-height:1.6;margin:3px 0;font-weight:500}
</style>
{% endblock %}
{% block content %}

<p class="back-link" style="margin-bottom:8px"><a href="/">← 総合管理にもどる</a></p>
<div class="sc-top"><h1>店舗スケジュール</h1>
  <div class="sh-nav"><a href="/schedule?month={{ nav.prev }}" aria-label="前の月">‹</a><b>{{ nav.label }}</b><a href="/schedule?month={{ nav.next }}" aria-label="次の月">›</a></div></div>
<div class="sc-sharing no-print"><div><strong>LINE自動送信</strong> <span class="sc-state">{{ line_enabled ? (line_auto ? '自動配信中' : '承認して配信') : '準備中' }}</span><p>月〜金 夜20:00に翌日分 ／ 金曜は日月の予定も共有</p></div><a href="/settings/staff-line?stream=store">配信の設定</a></div>
<p class="sc-hint no-print">日付を押すと、その日の予定を追加できます。出勤予定は別のカレンダーで管理します。</p>
<div class="cal">
  <div class="cal-head"><div>月</div><div>火</div><div>水</div><div>木</div><div>金</div><div class="sat">土</div><div class="sun">日</div></div>
  {% for week in weeks %}
  <div class="cal-week">
    {% for day in week %}
    {% if day %}
    <div class="cal-cell{% if day.today %} today{% endif %}" data-add-url="/schedule/add?date={{ day.date }}">
      <a class="cal-d{% if day.sun %} sun{% elseif day.sat %} sat{% endif %}" href="/schedule/add?date={{ day.date }}" aria-label="{{ day.date }}の予定を追加">{{ day.d }}{% if day.hol %}<span class="cal-hol">{{ day.hol }}</span>{% endif %}</a>
      {% if day.closed %}<div class="sc-closed">店休日</div>{% endif %}
      {% for e in day.events %}<div class="cal-ev">{{ e.title }}{% if e.store %}<small>（{{ e.store }}）</small>{% endif %}</div>{% endfor %}
    </div>
    {% else %}<div class="cal-cell blank"></div>{% endif %}
    {% endfor %}
  </div>
  {% endfor %}
</div>
<p class="no-print" style="margin:16px 0 30px"><a class="btn" href="/schedule/add" style="display:block;text-align:center">＋ この日だけの予定を追加</a><a href="/schedule/rules" style="display:block;text-align:center;margin-top:14px">繰り返し予定・登録済みの予定を管理</a></p>
{% endblock %}

{% block scripts %}<script>document.querySelectorAll('[data-add-url]').forEach(cell=>cell.addEventListener('click',e=>{if(!e.target.closest('a,button,input,select'))location.href=cell.dataset.addUrl;}));</script>{% endblock %}
