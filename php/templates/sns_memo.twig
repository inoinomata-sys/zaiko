{% extends 'base.twig' %}
{% block title %}SNS投稿メモ{% endblock %}
{% block head %}
<style>
.sns-memo { max-width: 480px; margin: 24px auto; padding: 0 12px; }
.sns-memo form, .sns-memo label { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
.sns-memo form { gap: 18px; }
.sns-memo input[type=text], .sns-memo input[type=file], .sns-memo textarea, .sns-memo button {
  width: 100%; min-width: 0; max-width: 100%; font-size: 16px; padding: 10px;
}
.sns-memo textarea { resize: vertical; }
.sns-memo button { min-height: 48px; }
.sns-menu { min-width: 0; border: 0; }
.sns-menu-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 8px; }
.sns-menu-options label {
  grid-template-columns: auto minmax(0, 1fr); align-items: center; min-height: 44px;
  padding: 8px; border: 1px solid var(--border); border-radius: 10px;
}
.sns-menu-options input { accent-color: var(--acc); width: 17px; height: 17px; }
</style>
{% endblock %}
{% block content %}
<section class="sns-memo">
  <a href="/">‹ トップへ</a>
  <h1>SNS投稿メモ</h1>
  {% if sent %}
    <p role="status">受け付けました。SNSの投稿案ができると猪股さんのLINEに届きます。</p>
    <a href="/sns-memo">次のメモを書く</a>
  {% else %}
    {% if error %}<p role="alert">{{ error }}</p>{% endif %}
    <form method="post" enctype="multipart/form-data" id="sns-memo-form">
      <input type="hidden" name="request_id" value="{{ request_id|default('') }}">
      <label>お客様の髪のお悩み
        <input type="text" name="concern" maxlength="100" placeholder="雨の日に前髪がうねる" value="{{ fields.concern|default('') }}">
      </label>
      <fieldset class="sns-menu">
        <legend>施術メニュー（複数選択可）</legend>
        <div class="sns-menu-options">
          {% for menu in menu_options %}
            <label>
              <input type="checkbox" name="menu[]" value="{{ menu }}"{% if menu in selected_menus|default([]) %} checked{% endif %}>
              <span>{{ menu }}</span>
            </label>
          {% endfor %}
        </div>
      </fieldset>
      <label>一覧にない施術メニュー
        <input type="text" name="menu_other" maxlength="100" value="{{ fields.menu_other|default('') }}">
      </label>
      <label>ひとことメモ
        <textarea name="memo" rows="4" required maxlength="1000" placeholder="相談したことや、施術で工夫したこと">{{ fields.memo|default('') }}</textarea>
      </label>
      <label>掲載できる写真（3MBまで）
        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp">
      </label>
      <button type="submit"{% if not can_send %} disabled{% endif %}>投稿案を作る</button>
    </form>
    <script>
      const form = document.getElementById('sns-memo-form');
      form.addEventListener('submit', () => {
        form.querySelector('button').disabled = true;
      });
      {% if can_send %}
      window.addEventListener('pageshow', () => { form.querySelector('button').disabled = false; });
      {% endif %}
    </script>
  {% endif %}
</section>
{% endblock %}
