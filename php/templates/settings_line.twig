{% extends 'base.twig' %}
{% block title %}LINE（業者さん）{% endblock %}
{% block head %}
<style>
.ln { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; margin-bottom: 10px; }
.ln .n { font-weight: 700; font-size: 16px; }
.ln .m { font-size: 12px; color: var(--fg2); margin: 2px 0 8px; word-break: break-all; }
.ln form{display:flex;gap:8px;flex-wrap:wrap}.ln-fields{display:flex;gap:8px;flex-wrap:wrap;width:100%;border:0;padding:0;margin:0;min-width:0}.ln-fields:disabled{opacity:.65}.ln select{min-width:0}.ln-status{font-size:13px;color:#786333;margin:8px 0}.ln-open[hidden]{display:none!important}
.ln select { flex: 1; font-size: 16px; padding: 10px; border: 1px solid var(--border); border-radius: 10px; font-family: inherit; }
.warn { background: #fff6e5; border: 1px solid #f0d49a; color: #7a5200; border-radius: 10px; padding: 12px 14px; font-size: 13px; line-height: 1.6; margin-bottom: 12px; }
</style>
{% endblock %}
{% block content %}
<p style="margin-bottom:10px"><a href="/settings">← 設定にもどる</a></p>
<h1 style="font-size:20px;font-weight:700;margin-bottom:8px">LINE（業者さん）</h1>
{% if msg %}<div class="warn" style="background:#eef6ff;border-color:#b9cdf5;color:#1a3d7a">{{ msg }}</div>{% endif %}
{% if ready %}
<form method="post" action="/settings/line/import" style="margin-bottom:12px"><input type="hidden" name="line_registration_key" value="{{ line_registration_key }}"><button class="btn btn-ghost" type="submit">友だちを取り込む</button></form>
{% endif %}
{% if not ready %}
<div class="warn">まだ、LINE とつながっていません。公式LINEで Messaging API を使えるようにして、シークレットとトークンを、サーバーの設定（config.php）に入れると、つながります。</div>
{% endif %}
<p style="font-size:13px;color:var(--fg2);margin-bottom:12px">業者さんが、発注専用LINEに、一言送ると、ここに出ます。仕入先を選ぶと、発注書の送り先になります（1つの仕入先に、1人だけ）。</p>
<div class="warn">送信先はロックされています。変えたい相手の「送信先を変更」を押した時だけ変更できます。</div>
{% for c in contacts %}
<div class="ln">
  <div class="n">{{ c.display_name ?: '（名前なし）' }}</div>
  <div class="m">最後の発言：{{ c.last_text ?: '—' }}（{{ c.last_at }}）</div>
  <form method="post" action="/settings/line/assign" class="ln-assignment" data-name="{{ c.display_name ?: '（名前なし）' }}">
    <input type="hidden" name="line_registration_key" value="{{ line_registration_key }}"><input type="hidden" name="user_id" value="{{ c.user_id }}">
    <input type="hidden" name="previous_supplier" value="{{ c.supplier }}"><input type="hidden" name="confirm_change" value="0">
    <div class="ln-status" role="status">ロック中</div><button type="button" class="btn btn-ghost ln-open">送信先を変更</button>
    <fieldset disabled class="ln-fields"><select name="supplier" aria-label="送信先の仕入先">
      <option value="">仕入先を選ぶ</option>
      {% for s in supplier_names %}<option value="{{ s }}"{% if c.supplier == s %} selected{% endif %}>{{ s }}</option>{% endfor %}
    </select>
    <button class="btn" type="submit">変更を保存</button><button class="btn btn-ghost ln-cancel" type="button">やめる</button></fieldset>
  </form>
</div>
{% else %}
<p style="color:var(--fg2);margin:20px 0">まだ誰も出ていません。</p>
{% endfor %}
{% endblock %}

{% block scripts %}
<script>
(() => {
 const forms=[...document.querySelectorAll('.ln-assignment')];
 function lock(f){f.querySelector('fieldset').disabled=true;f.querySelector('select').value=f.querySelector('[name=previous_supplier]').value;f.querySelector('[name=confirm_change]').value='0';f.querySelector('.ln-open').hidden=false;f.querySelector('.ln-status').textContent='ロック中';}
 forms.forEach(f=>{f.querySelector('.ln-open').addEventListener('click',()=>{forms.forEach(lock);f.querySelector('fieldset').disabled=false;f.querySelector('.ln-open').hidden=true;f.querySelector('.ln-status').textContent='変更中（保存するまで変わりません）';});f.querySelector('.ln-cancel').addEventListener('click',()=>lock(f));f.addEventListener('submit',e=>{const select=f.querySelector('select');if(f.querySelector('fieldset').disabled||!confirm(`「${f.dataset.name}」の送信先を「${select.selectedOptions[0].textContent}」に変更しますか？`)){e.preventDefault();return;}f.querySelector('[name=confirm_change]').value='1';});});
 window.addEventListener('pageshow',e=>{forms.forEach(lock);if(e.persisted)location.replace('/settings/line');});
})();
</script>
{% endblock %}
